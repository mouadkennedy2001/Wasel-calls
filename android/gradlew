#!/usr/bin/env sh
#
# Minimal Gradle wrapper launcher. The binary gradle-wrapper.jar is not
# checked in here; run "npx cap add android" to regenerate the platform
# with a complete wrapper before building from the command line.
#
set -e

APP_HOME=$(cd "$(dirname "$0")" && pwd)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$JAR" ]; then
  echo "ERROR: gradle/wrapper/gradle-wrapper.jar is missing." >&2
  echo "Run 'npx cap add android' (after saving custom files) to regenerate it." >&2
  exit 1
fi

exec java ${JAVA_OPTS:-} -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
