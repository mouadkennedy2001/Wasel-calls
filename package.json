{
  "name": "wasel-call",
  "version": "1.0.0",
  "private": true,
  "description": "مكالمات واصل - محادثة ومكالمات صوتية ومشاركة ملفات على الشبكة المحلية",
  "main": "src/main/electron.js",
  "scripts": {
    "start": "node src/main/server.js",
    "dev": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "icons": "python scripts/make-icons.py",
    "build": "electron-builder",
    "build:mobile": "node scripts/build-mobile.js",
    "apk": "node scripts/build-apk.js"
  },
  "keywords": ["lan", "chat", "voice", "electron", "webrtc", "wasel-call"],
  "license": "MIT",
  "author": "مكالمات واصل",
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.wasel.call",
    "productName": "مكالمات واصل",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "build/icons/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icons/icon.ico" },
    "linux": { "target": ["AppImage", "deb"], "icon": "build/icons", "category": "Network" },
    "mac": { "target": ["dmg"], "icon": "build/icons/icon.icns" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  },
  "engines": { "node": ">=20" }
}
